---
// import { Image } from 'astro:assets';
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  date,
  updatedDate,
  heroImage,
  coverImage,
} = Astro.props;
const postImage = coverImage ?? heroImage;
const postDate = pubDate ?? date;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 12px;
        background: rgb(var(--gray-light));
        margin-bottom: 2em;
      }
      .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 100%;
        max-width: 780px;
        box-sizing: border-box;
        margin: auto;
        padding: 1.25rem clamp(1rem, 4vw, 2.5rem);
        font-size: clamp(1.0625rem, 0.98rem + 0.25vw, 1.1875rem);
        line-height: 1.85;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1.18;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .prose :global(p) {
        line-height: 1.85;
      }
      .prose :global(h2) {
        margin-top: 1.65em;
        line-height: 1.3;
      }
      .prose :global(img) {
        display: block;
        margin: 1.5rem auto 0.5rem;
      }
      @media (max-width: 600px) {
        .prose { padding-inline: 1rem; }
        .title { padding: 0.5rem 0; }
        .title h1 { font-size: clamp(1.9rem, 7vw, 2.6rem); }
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {postImage && <img src={postImage} alt="" />}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={postDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={postDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <div style="max-width:720px;margin:3em auto;padding:0 1em;">
      <div id="disqus_thread"></div>
      <script>
        var disqus_config = function () {
          this.page.url = window.location.href;
          this.page.identifier = window.location.pathname;
        };
        (function () {
          var d = document,
            s = d.createElement("script");
          s.src = "https://mondofrattolillo-1.disqus.com/embed.js";
          s.setAttribute("data-timestamp", +new Date());
          (d.head || d.body).appendChild(s);
        })();
      </script>
      <noscript
        >Please enable JavaScript to view the <a
          href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a
        ></noscript
      >
    </div>
    <Footer />
  </body>
</html>
